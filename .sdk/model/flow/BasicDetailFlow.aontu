# BasicDetailFlow

main: kit: flow: BasicDetailFlow:
{
  entity: "detail",
  kind: "basic",
  name: "BasicDetailFlow",
  step: [
    {
      input: {
        ref: "detail_ref01",
        srcdatavar: "detail_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "detail01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-detail_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDetailFlow"
}